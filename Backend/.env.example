# Get a free key at https://build.nvidia.com (open any model -> "Get API Key")
LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any OpenAI-compatible endpoint works (NVIDIA NIM, Groq, Together, OpenRouter, local Ollama...)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=z-ai/glm-5.3-flash
# Used automatically if the main model is retired, unavailable or times out (leave empty to disable)
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# How long "thinking" models reason before answering: low (fast) / medium / high, or empty for model default
LLM_REASONING_EFFORT=low
# Seconds to wait for one model response
LLM_TIMEOUT=90

# How many resumes are sent to the model at the same time (NVIDIA's free tier rejects bursts above ~3-4)
LLM_CONCURRENCY=3

MAX_RESUMES=20
MAX_FILE_MB=10

# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173
